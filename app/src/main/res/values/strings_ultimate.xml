    <!-- Backup / data import-export -->
    <string name="ult_dio_backup_created">Encrypted full backup created successfully. Includes the database (workouts, activity, sleep, heart rate), app and per-device settings, and saved routes. Keep it and remember the password: without it, it cannot be restored.</string>
    <string name="ult_dio_export_failed">Export failed: %1$s</string>
    <string name="ult_dio_restored">Backup restored: database + %1$d settings files</string>
    <string name="ult_dio_restored_routes">" + %1$d routes"</string>
    <string name="ult_dio_restored_tail">. Restart the app to apply the changes. Note: the Bluetooth pairing cannot be restored (it belongs to Android); reconnect the watch from the app.</string>
    <string name="ult_dio_import_failed">Import failed: %1$s</string>
    <string name="ult_dio_db_exported">Database exported (unencrypted, DB only).</string>
    <string name="ult_backup">Backup</string>
    <string name="ult_dio_enc_title">Encrypted full backup</string>
    <string name="ult_dio_enc_body">Creates a single .ugbak file you can carry to another phone. Includes the database (workouts, activity, sleep, heart rate), all settings (app and per-device) and saved routes. It is encrypted with your password (AES-256). Without the password it cannot be restored, so do not forget it.</string>
    <string name="ult_dio_enc_btn">Create encrypted backup…</string>
    <string name="ult_dio_restore_title">Restore full backup</string>
    <string name="ult_dio_restore_body">Choose a .ugbak file and type its password. It OVERWRITES the current database and settings with those from the backup. Afterwards you must restart the app for the changes to take effect.</string>
