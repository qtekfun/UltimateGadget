<?xml version="1.0" encoding="utf-8"?>
<!-- UltimateGadget: brand dark splash with the app icon centred (API 21..30; on API 31+ the
     system SplashScreen in values-v31 takes over, this stays the post-splash window background). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:drawable="@color/ultimate_splash_background" />

    <item
        android:width="208dp"
        android:height="208dp"
        android:gravity="center"
        android:drawable="@drawable/ic_launcher_foreground" />

</layer-list>
